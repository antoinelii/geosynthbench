{
  "include": ["src", "scripts"],
  "exclude": [
    "**/__pycache__",
    "outputs_*",
    "**/.*",
    "**/node_modules/**",
    "**/venv/**",
    "**/.venv/**"
  ],
  "pythonVersion": "3.12",

  "typeCheckingMode": "basic",
  "strict": ["src"],

  "reportMissingTypeStubs": "none",
  "reportPrivateImportUsage": "none"
}
